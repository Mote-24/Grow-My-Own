# ── Core functions ──────────────────────────────────────────────────────────
def returnEfficiency(goalRatio, foodRatio):
    """Compare a food's nutrient ratio to the goal ratio, both normalized to per-100-cal."""
    normFactor  = 100 / foodRatio[1]
    foodNormed  = round(foodRatio[0] * normFactor, 4)
    goalNormed  = goalRatio[0] * (100 / goalRatio[1])
    return min(foodNormed / goalNormed, 1.0) if goalNormed != 0 else 0

def scoreNutrientList(foodRatios, goalRatio):
    """Run returnEfficiency across a list of foods for one nutrient."""
    return [returnEfficiency(goalRatio, food) for food in foodRatios]

def returnWeightedScore(nutrientScoreLists, weights):
    """
    nutrientScoreLists: dict of {name: [score_food1, score_food2, ...]}
    weights:            dict of {name: weight_value}
    Returns the weighted average score across all foods and nutrients.
    """
    totalWeight = sum(weights.values())
    numFoods    = len(next(iter(nutrientScoreLists.values())))
    foodScores  = []

    for foodIdx in range(numFoods):
        weightedSum = 0
        for nutrient, scores in nutrientScoreLists.items():
            weightedSum += scores[foodIdx] * weights[nutrient]
        foodScores.append(weightedSum / totalWeight)

    return sum(foodScores) / numFoods

