def main(page: ft.Page):
    page.title = "Grow My Own 🌱"
    page.bgcolor = CREAM
    page.padding = 0
    page.window.width = 420
    page.window.min_width = 380
    page.theme = ft.Theme(color_scheme_seed=SAGE)

    # ── File picker (MUST be in overlay to work) ──
    file_picker = ft.FilePicker()
    page.overlay.append(file_picker)

    # ── Refs ──
    garden_panel    = ft.Ref[ft.Column]()
    nutrition_panel = ft.Ref[ft.Column]()
    log_panel       = ft.Ref[ft.Column]()

    plant_emoji_ctrl = ft.Ref[ft.Text]()
    plant_label_ctrl = ft.Ref[ft.Text]()
    score_ctrl       = ft.Ref[ft.Text]()
    daily_goal_ctrl  = ft.Ref[ft.Text]()
    produce_chips_row = ft.Ref[ft.Row]()
    nutrition_note   = ft.Ref[ft.Text]()

    tab_garden_btn    = ft.Ref[ft.TextButton]()
    tab_nutrition_btn = ft.Ref[ft.TextButton]()
    tab_log_btn       = ft.Ref[ft.TextButton]()

    food_autocomplete_ref = ft.Ref[ft.AutoComplete]()
    log_list_ref          = ft.Ref[ft.Column]()

    # macro / vitamin display refs
    macro_value = {}   # key -> ft.Text
    macro_fill  = {}   # key -> ft.Container
    vit_value   = {}   # key -> ft.Text
    vit_fill    = {}   # key -> ft.Container

    # mutable holders
    food_log = []
    selected_food = {"value": ""}
    pending_photo = {"description": None, "fdc_id": None, "mass": 100.0}
    yn_cards = {}
    selected_allergies = set()

    # dialog refs
    meal_title_ctrl = ft.Ref[ft.Text]()
    meal_body_ctrl  = ft.Ref[ft.Text]()
    meal_dialog     = ft.Ref[ft.AlertDialog]()
    setup_dialog    = ft.Ref[ft.AlertDialog]()
    age_dropdown    = ft.Ref[ft.Dropdown]()
    gender_dropdown = ft.Ref[ft.Dropdown]()
    location_dropdown = ft.Ref[ft.Dropdown]()
    loading_text_ctrl = ft.Ref[ft.Text]()
    loading_dialog    = ft.Ref[ft.AlertDialog]()
    confirm_desc_ctrl = ft.Ref[ft.Text]()
    confirm_conf_ctrl = ft.Ref[ft.Text]()
    confirm_dialog    = ft.Ref[ft.AlertDialog]()
    manual_field_ref  = ft.Ref[ft.TextField]()
    manual_error_ref  = ft.Ref[ft.Text]()
    manual_dialog     = ft.Ref[ft.AlertDialog]()

    # ════════════════════════════════════════
    # LOADING SCREEN (modal, reusable)
    # ════════════════════════════════════════
    def show_loading(message):
        if loading_text_ctrl.current:
            loading_text_ctrl.current.value = message
        if loading_dialog.current:
            loading_dialog.current.open = True
        page.update()

    def hide_loading():
        if loading_dialog.current:
            loading_dialog.current.open = False
        page.update()

    loading_dialog_ctrl = ft.AlertDialog(
        ref=loading_dialog, modal=True,
        content=ft.Container(
            width=240,
            content=ft.Row(
                [
                    ft.ProgressRing(width=26, height=26, stroke_width=3, color=SAGE),
                    ft.Text("Working…", ref=loading_text_ctrl, size=14, color=TEXT_PRI),
                ],
                spacing=14, vertical_alignment="center",
            ),
            padding=ft.Padding(left=4, right=4, top=10, bottom=10),
        ),
    )
    page.overlay.append(loading_dialog_ctrl)

    # ════════════════════════════════════════
    # NUTRITION TAB REFRESH
    # ════════════════════════════════════════
    def refresh_nutrition():
        n = state.nutrition()
        for key in ("calcium", "iron", "total_fiber", "protein", "unsat_fat"):
            if macro_value.get(key):
                macro_value[key].value = fmt(key, n[key])
            target = DAILY_TARGETS[key]
            pct = min(100, (n[key] / target * 100) if target else 0)
            if macro_fill.get(key):
                macro_fill[key].width = max(2, int(pct * 0.9))
        for vkey in ("vit_a", "vit_c", "vit_d", "vit_e"):
            target = DAILY_TARGETS[vkey]
            pct = min(100, round(n[vkey] / target * 100) if target else 0)
            if vit_value.get(vkey):
                vit_value[vkey].value = f"{int(pct)}%"
            if vit_fill.get(vkey):
                vit_fill[vkey].width = max(2, int(pct * 1.6))
        page.update()

    # ════════════════════════════════════════
    # TODAY'S LOG
    # ════════════════════════════════════════
    def refresh_log():
        if not log_list_ref.current:
            return
        if food_log:
            log_list_ref.current.controls = [
                ft.Text(item, size=13, color=TEXT_PRI) for item in food_log
            ]
        else:
            log_list_ref.current.controls = [
                ft.Text("Nothing logged yet today.", size=13, color=TEXT_SEC, italic=True)
            ]
        page.update()

    def add_to_log(text):
        food_log.append(text)
        refresh_log()

    # ════════════════════════════════════════
    # CORE: log a food (threaded + loading)
    #   Loading stays up until nutrition is updated.
    # ════════════════════════════════════════
    def log_food_by_name(name, source="🍽️"):
        show_loading("Updating your nutrition…")

        def worker():
            try:
                matched, fdc = db.find_match(name)
                if not fdc:
                    hide_loading()
                    open_manual_dialog(error=f"Couldn't find “{name}”. Try another name.")
                    return
                nutrients = db.nutrients_for_fdc(fdc)      # per 100 g
                state.apply_nutrients(nutrients, scale=1.0)
                add_to_log(f"{source} {matched}")
                refresh_nutrition()
            except Exception as e:
                print("[log_food_by_name]", e)
            finally:
                hide_loading()

        threading.Thread(target=worker, daemon=True).start()

    def log_food_from_photo(description, fdc_id, mass_g, source="📷"):
        show_loading("Updating your nutrition…")

        def worker():
            try:
                nutrients = db.nutrients_for_fdc(fdc_id)   # per 100 g
                state.apply_nutrients(nutrients, scale=mass_g / 100.0)
                add_to_log(f"{source} {description}  (~{int(mass_g)} g)")
                refresh_nutrition()
            except Exception as e:
                print("[log_food_from_photo]", e)
            finally:
                hide_loading()

