# ─────────────────────────────────────────────
# FOOD VISION MODEL  (CLIP match + optional mass)
#   Loaded once, reused for every photo.
# ─────────────────────────────────────────────
class FoodVisionModel:
    TEXT_VECTOR_CACHE = os.path.join(BASE_DIR, "text_vectors.npy")

    def __init__(self, nutrition_db):
        self.db = nutrition_db
        self.model = None
        self.preprocess = None
        self.tokenizer = None
        self.text_vectors = None  # np.ndarray aligned with db.descriptions()

    # ---- lazy, one-time load ----
    def _ensure_loaded(self):
        if self.model is not None:
            return
        import torch
        import open_clip

        torch.set_num_threads(max(1, (os.cpu_count() or 4) // 2))
        model, _, preprocess = open_clip.create_model_and_transforms(
            "ViT-B-32", pretrained="laion2b_s34b_b79k"
        )
        model.eval()
        self.model = model
        self.preprocess = preprocess
        self.tokenizer = open_clip.get_tokenizer("ViT-B-32")
        self._load_or_build_text_vectors()

    def _embed_texts(self, texts, batch_size=64):
        import torch
        import numpy as np
        out = []
        with torch.no_grad():
            for i in range(0, len(texts), batch_size):
                tokens = self.tokenizer(texts[i:i + batch_size])
                emb = self.model.encode_text(tokens)
                emb = emb / emb.norm(dim=-1, keepdim=True)
                out.append(emb.cpu().numpy())
                print(f"  embedding text {min(i + batch_size, len(texts))}/{len(texts)}", end="\r")
        print()
        return np.vstack(out)

    def _load_or_build_text_vectors(self):
        import numpy as np
        descs = self.db.descriptions()
        if not descs:
            self.text_vectors = np.empty((0, 512), dtype="float32")
            return
        if os.path.exists(self.TEXT_VECTOR_CACHE):
            cached = np.load(self.TEXT_VECTOR_CACHE)
            if cached.shape[0] == len(descs):
                self.text_vectors = cached
                return
        print(f"[Vision] Building text embeddings for {len(descs)} foods (one-time)...")
        vecs = self._embed_texts(descs)
        try:
            np.save(self.TEXT_VECTOR_CACHE, vecs)
        except Exception as e:
            print(f"[Vision] couldn't cache text vectors: {e}")
        self.text_vectors = vecs

    # ---- main entry point ----
    def identify(self, image_path):
        """Return dict: ok, description, fdc_id, confidence (0-1), mass (g), error."""
        result = {"ok": False, "description": None, "fdc_id": None,
                  "confidence": 0.0, "mass": 100.0, "error": None}
        try:
            import numpy as np
            import torch
            from PIL import Image

            self._ensure_loaded()
            descs = self.db.descriptions()
            if not descs or self.text_vectors is None or self.text_vectors.shape[0] == 0:
                result["error"] = "Food database is empty."
                return result

            image = Image.open(image_path).convert("RGB")
            with torch.no_grad():
                img_t = self.preprocess(image).unsqueeze(0)
                img_vec = self.model.encode_image(img_t)
                img_vec = img_vec / img_vec.norm(dim=-1, keepdim=True)
                img_vec = img_vec.cpu().numpy()

            sims = np.dot(img_vec, self.text_vectors.T).reshape(-1)
            best = int(np.argmax(sims))
            description = descs[best]

            result["ok"] = True
            result["description"] = description
            result["confidence"] = float(sims[best])
            result["fdc_id"] = self.db.fdc_for(description)
            result["mass"] = self._estimate_mass(image_path)  # graceful fallback inside
        except Exception as e:
            import traceback
            traceback.print_exc()
            result["error"] = str(e)
        return result

    # ---- optional geometric mass estimate (defaults to 100 g) ----
    def _estimate_mass(self, image_path, default_g=100.0):
        """Best-effort SAM + depth volume estimate. Any failure -> default_g."""
        try:
            import numpy as np
            import cv2
            import torch
            from PIL import Image
            from sam2.build_sam import build_sam2
            from sam2.sam2_image_predictor import SAM2ImagePredictor
            from depth_anything_v2.dpt import DepthAnythingV2

            sam_ckpt = os.path.join(BASE_DIR, "checkpoints", "sam2_hiera_small.pt")
            depth_ckpt = os.path.join(BASE_DIR, "checkpoints", "depth_anything_v2_vits.pth")
            if not (os.path.exists(sam_ckpt) and os.path.exists(depth_ckpt)):
                return default_g

            device = "cuda" if torch.cuda.is_available() else "cpu"

            # --- segmentation: central object mask ---
            sam = build_sam2("configs/sam2/sam2_hiera_s", sam_ckpt,
                             device=device, apply_postprocessing=False)
            predictor = SAM2ImagePredictor(sam)
            image = np.array(Image.open(image_path).convert("RGB"))
            predictor.set_image(image)
            h, w, _ = image.shape
            masks, scores, _ = predictor.predict(
                point_coords=np.array([[w // 2, h // 2]]),
                point_labels=np.array([1]),
                multimask_output=True,
            )
            mask = masks[int(np.argmax(scores))].astype(np.uint8)
            k = np.ones((5, 5), np.uint8)
            mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, k)
            mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k).astype(bool)

            # --- depth ---
            depth_model = DepthAnythingV2(encoder="vits", features=64,
                                          out_channels=[48, 96, 192, 384])
            depth_model.load_state_dict(torch.load(depth_ckpt, map_location=device))
            depth_model.to(device).eval()
            depth = depth_model.infer_image(cv2.imread(image_path)).astype(np.float32)
            depth = (depth - depth.min()) / (depth.max() - depth.min() + 1e-8)

            # --- volume -> mass ---
            depth = cv2.resize(depth, (mask.shape[1], mask.shape[0]))
            boundary = cv2.dilate(mask.astype(np.uint8), np.ones((7, 7))) - mask.astype(np.uint8)
            vals = depth[boundary == 1]
            plate = np.median(vals) if len(vals) > 10 else np.median(depth)
            height = np.clip(plate - depth, 0, None) * mask
            pixel_to_cm = 0.05
            volume_cm3 = float(np.sum(height * (pixel_to_cm ** 2)))
            mass = volume_cm3 * 1.05  # rough density
            return mass if mass > 1 else default_g
        except Exception:
            return default_g


