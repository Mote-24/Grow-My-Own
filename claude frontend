class AppState:
    def __init__(self):
        self.diet      = "omnivore"
        self.goal      = "less_processed"
        self.location  = "us"
        self.gender    = "Male"
        self.age       = "18"
        self.allergies = []
        self.produce   = ["apple", "kale", "blueberries"]
        self.yn_state  = {}     # {index: "yes"|"no"}
        self.plant_level = 1
        self.serving   = 1.0
        self.BASE = {k: 0.0 for k in NUTRIENT_KEYS}

    def compute_plant_level(self):
        yes_count = sum(1 for v in self.yn_state.values() if v == "yes")
        produce_bonus = min(len(self.produce), 4)
        self.plant_level = min(6, 1 + yes_count + produce_bonus // 2)

    def overall_score(self):
        yes_count = sum(1 for v in self.yn_state.values() if v == "yes")
        return min(100, 55 + yes_count * 8 + min(len(self.produce), 4) * 4)

    def nutrition(self):
        s = self.serving
        return {k: round(v * s, 1) for k, v in self.BASE.items()}

    def apply_nutrients(self, nutrients, scale=1.0):
        for k, v in nutrients.items():
            if k in self.BASE:
                self.BASE[k] += v * scale

    def reset_day(self):
        self.BASE = {k: 0.0 for k in NUTRIENT_KEYS}
        self.yn_state = {}


