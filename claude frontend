    async def upload_food_photo(e):
        files = await file_picker.pick_files(
            allow_multiple=False,
            file_type=ft.FilePickerFileType.CUSTOM,
            allowed_extensions=["jpg", "jpeg", "png"],
        )
        if not files:
            return
        path = files[0].path
        if not path:
            open_manual_dialog(error="Couldn't read that file's path. Type the food instead.")
            return

        show_loading("Analyzing your photo…")

        def worker():
            res = get_vision_model().identify(path)
            hide_loading()
            if res.get("ok") and res.get("description") and res.get("fdc_id"):
                pending_photo["description"] = res["description"]
                pending_photo["fdc_id"]      = res["fdc_id"]
                pending_photo["mass"]        = res.get("mass", 100.0)
                open_confirm_dialog(res["description"], res["confidence"], res["mass"])
            else:
                reason = res.get("error") or "We couldn't recognize that one."
                open_manual_dialog(error=f"{reason} Type the food name instead.")

        threading.Thread(target=worker, daemon=True).start()

