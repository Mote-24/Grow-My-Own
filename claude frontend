def claude(prompt: str, max_tokens: int = 400) -> str:
    body = json.dumps({
        "model": "claude-sonnet-4-6",
        "max_tokens": max_tokens,
        "messages": [{"role": "user", "content": prompt}],
    }).encode()
    req = urllib.request.Request(
        "https://api.anthropic.com/v1/messages",
        data=body,
        headers={
            "Content-Type": "application/json",
            "x-api-key": API_KEY,
            "anthropic-version": "2023-06-01",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = json.loads(resp.read())
    return data["content"][0]["text"].strip()


def fetch_daily_goal(callback):
    prompt = (
        "Give one small, doable daily milestone for someone trying to eat more "
        f"whole, less-processed food (diet: {state.diet}). One friendly sentence, "
        "realistic and encouraging, like 'prep apple slices before bed.' No health claims."
    )
    try:
        callback(claude(prompt, max_tokens=120))
    except Exception:
        callback("Slice some fruit and leave it somewhere visible today — easy access makes all the difference!")


def fetch_meal_ideas(fruit, callback):
    produce_str   = ", ".join(state.produce) or fruit
    allergies_str = ", ".join(state.allergies) or "none"
    prompt = (
        f"Suggest 3 cheap, easy meal ideas featuring {fruit} and any of: {produce_str}. "
        f"Diet: {state.diet}. Cuisine preference: {state.location}. Avoid: {allergies_str}. "
        "Friendly and practical, no health claims. Short numbered list: bold name + 1 sentence."
    )
    try:
        callback(claude(prompt, max_tokens=400))
    except Exception:
        callback("Couldn't load ideas right now — check your API key and try again!")


