def thin_border(color="#DDDDDD", w=0.5):
    return ft.Border(
        left=ft.BorderSide(w, color), right=ft.BorderSide(w, color),
        top=ft.BorderSide(w, color), bottom=ft.BorderSide(w, color),
    )


def section_label(text):
    return ft.Text(text, size=12, color=TEXT_SEC, weight="w500")


def card(content, padding=16, bg=WHITE):
    return ft.Container(content=content, bgcolor=bg, border_radius=14,
                        border=thin_border(), padding=padding)


def fmt(key, value):
    if key in ("calcium", "iron"):
        return str(int(round(value)))
    return f"{value:.1f}"


