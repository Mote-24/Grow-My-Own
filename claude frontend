# NUTRITION DATA LAYER  (CSV lookups, cached)
# ─────────────────────────────────────────────
class NutritionDB:
    """Resolves food descriptions -> fdc_id -> nutrient amounts (per 100 g)."""

    def __init__(self, base_dir=BASE_DIR):
        self.food_csv          = os.path.join(base_dir, "food.csv")
        self.food_nutrient_csv = os.path.join(base_dir, "food_nutrient.csv")
        self._descriptions = None   # list[str]
        self._desc_to_fdc  = None   # dict[str, str]

    # ---- food index (description <-> fdc_id) ----
    def load_food_index(self):
        if self._desc_to_fdc is not None:
            return
        descriptions, desc_to_fdc = [], {}
        try:
            with open(self.food_csv, "r", encoding="utf-8", newline="") as f:
                for row in csv.DictReader(f):
                    d = (row.get("description") or "").strip()
                    fdc = (row.get("fdc_id") or "").strip()
                    if d and fdc and d not in desc_to_fdc:
                        descriptions.append(d)
                        desc_to_fdc[d] = fdc
        except FileNotFoundError:
            print(f"[NutritionDB] food.csv not found at {self.food_csv}")
        self._descriptions = descriptions
        self._desc_to_fdc  = desc_to_fdc

    def descriptions(self):
        self.load_food_index()
        return self._descriptions

    def fdc_for(self, description):
        self.load_food_index()
        return self._desc_to_fdc.get(description.strip())

    def find_match(self, text):
        """Return (description, fdc_id). Exact match first, then 'contains'."""
        self.load_food_index()
        t = text.strip()
        fdc = self._desc_to_fdc.get(t)
        if fdc:
            return t, fdc
        tl = t.lower()
        for d in self._descriptions:
            if tl in d.lower():
                return d, self._desc_to_fdc[d]
        return None, None

    # ---- nutrient amounts for a given food (per 100 g) ----
    def nutrients_for_fdc(self, fdc_id):
        totals = defaultdict(float)
        if not fdc_id:
            return totals
        try:
            with open(self.food_nutrient_csv, "r", encoding="utf-8", newline="") as f:
                for row in csv.DictReader(f):
                    if row.get("fdc_id") != fdc_id:
                        continue
                    key = NUTRIENT_MAP.get(row.get("nutrient_id"))
                    if not key:
                        continue
                    try:
                        totals[key] += float(row.get("amount") or 0)
                    except ValueError:
                        pass
        except FileNotFoundError:
            print(f"[NutritionDB] food_nutrient.csv not found at {self.food_nutrient_csv}")
        return totals


